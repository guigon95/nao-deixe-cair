# Anúncios da Disparada (veja docs/MONETIZACAO.md). Sem nada definido: anúncios desligados.
# Copie para .env.local (dev) ou defina no painel da Vercel (produção).

# off | google | dev   (dev = anúncios SIMULADOS, só em `npm run dev`)
VITE_ADS_PROVIDER=off
# Publisher ID do AdSense, obrigatório para google
VITE_ADSENSE_CLIENT=
# on = modo de teste oficial do Google (data-adbreak-test). Nunca em produção.
VITE_ADS_TEST_MODE=off
VITE_ADS_INTERSTITIAL=on
VITE_ADS_INTERSTITIAL_EVERY_RUNS=3
VITE_ADS_INTERSTITIAL_MIN_INTERVAL_S=120
VITE_ADS_REWARDED_REVIVES=1
