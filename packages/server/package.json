{
  "name": "@ndc/server",
  "version": "1.1.0",
  "private": true,
  "description": "API do Não Deixe Cair: contas de jogador, sessões e ranking online",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
