# Copie para packages/server/.env no desenvolvimento. Nunca commite segredos reais.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ndc?schema=public"
# Conexão direta usada pelas migrações (na Vercel a integração Neon define; localmente, igual à de cima).
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/ndc?schema=public"
# Assina os tokens de partida. String longa e aleatória: `openssl rand -base64 48`
APP_SECRET="troque-por-uma-string-longa-e-aleatoria"
PORT=4000
SESSION_TTL_DAYS=180
